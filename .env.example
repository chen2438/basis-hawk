BASIS_HAWK_DATABASE_URL=postgresql+asyncpg://basis_hawk:replace-me@postgres/basis_hawk
BASIS_HAWK_LOG_LEVEL=INFO
BASIS_HAWK_HTTP_TIMEOUT_SECONDS=10
BASIS_HAWK_HOST=0.0.0.0
BASIS_HAWK_PORT=8000
BASIS_HAWK_AUTH_REQUIRED=true
BASIS_HAWK_SECURE_COOKIES=true
BASIS_HAWK_SESSION_HOURS=12
# Generate with: .venv/bin/python -c "from basis_hawk.crypto import SecretCipher; print(SecretCipher.generate_key())"
BASIS_HAWK_CREDENTIAL_MASTER_KEY=replace-with-a-generated-key

# Optional notification channels. Leave all values blank to keep a channel disabled.
BASIS_HAWK_TELEGRAM_BOT_TOKEN=
BASIS_HAWK_TELEGRAM_CHAT_ID=
BASIS_HAWK_TELEGRAM_WEBHOOK_SECRET=
BASIS_HAWK_SMTP_HOST=
BASIS_HAWK_SMTP_PORT=587
BASIS_HAWK_SMTP_SECURITY=starttls
BASIS_HAWK_SMTP_USERNAME=
BASIS_HAWK_SMTP_PASSWORD=
BASIS_HAWK_SMTP_FROM=
BASIS_HAWK_SMTP_TO=
BASIS_HAWK_NOTIFICATION_BATCH_SIZE=20

# Internal USDT account transfers are disabled until both limits are positive.
BASIS_HAWK_TRANSFER_PER_REQUEST_LIMIT_USDT=0
BASIS_HAWK_TRANSFER_DAILY_LIMIT_USDT=0

# Separate 32-byte URL-safe Base64 key for authenticated PostgreSQL backups.
# Generate independently from the credential master key.
BASIS_HAWK_BACKUP_KEY=
BASIS_HAWK_BACKUP_INTERVAL_SECONDS=86400

# Docker Compose / Caddy.
BASIS_HAWK_DOMAIN=hawk.example.com
POSTGRES_DB=basis_hawk
POSTGRES_USER=basis_hawk
POSTGRES_PASSWORD=replace-me
