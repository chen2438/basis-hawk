BASIS_HAWK_DATABASE_URL=postgresql+asyncpg://basis_hawk:replace-me@postgres/basis_hawk
BASIS_HAWK_LOG_LEVEL=INFO
BASIS_HAWK_HTTP_TIMEOUT_SECONDS=10
BASIS_HAWK_HOST=0.0.0.0
BASIS_HAWK_PORT=8000
BASIS_HAWK_AUTH_REQUIRED=true
BASIS_HAWK_SECURE_COOKIES=true
BASIS_HAWK_SESSION_HOURS=12
# Generate with: .venv/bin/python -c "from basis_hawk.crypto import SecretCipher; print(SecretCipher.generate_key())"
BASIS_HAWK_CREDENTIAL_MASTER_KEY=replace-with-a-generated-key

# Docker Compose / Caddy.
BASIS_HAWK_DOMAIN=hawk.example.com
POSTGRES_DB=basis_hawk
POSTGRES_USER=basis_hawk
POSTGRES_PASSWORD=replace-me
