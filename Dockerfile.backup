FROM postgres:17-alpine

RUN apk add --no-cache python3 py3-cryptography \
    && addgroup -g 10001 basis-hawk \
    && adduser -D -u 10001 -G basis-hawk basis-hawk \
    && mkdir /backups \
    && chown basis-hawk:basis-hawk /backups

WORKDIR /app
COPY --chown=basis-hawk:basis-hawk src/basis_hawk /app/basis_hawk
VOLUME ["/backups"]
USER basis-hawk
ENTRYPOINT ["python3", "-m", "basis_hawk.backup"]
CMD ["loop"]
